# Flask
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# MySQL (matches thesis section 3.4.3 / 3.8.1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=frpews
DB_USER=frpews_user
DB_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://frpews_user:change-me@localhost:3306/frpews

# Twilio (section 4.6.1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Data sources (section 3.5.1) - optional, used by scheduled ingestion
NIMET_API_KEY=
NIHSA_API_KEY=

# Scheduler
PREDICTION_INTERVAL_HOURS=6

# Auth session length (hours). SPA has no refresh-token flow.
JWT_ACCESS_HOURS=12

# Browser origins allowed to call the API directly (Docker/local Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
